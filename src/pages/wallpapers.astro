---
// src/pages/wallpapers.astro
import Layout from '../layouts/Layout.astro';
import WallpaperCard from '../components/WallpaperCard.astro';
import type { Wallpaper } from '../components/WallpaperCard.astro';

// 1. Importaciones locales (PC y Marcas)
import { wallpapers as wallpapersBrand } from '../data/wallpapers-brand';
import { wallpapers as pcWallpapers } from '../data/wallpapers';

// 2. URLs RSS oficiales de tus 2 tableros de Pinterest
const PINTEREST_RSS_URLS = [
  'https://www.pinterest.com/arevaloalfredo69/wallpapers-branding.rss', 
  'https://www.pinterest.com/arevaloalfredo69/veyxara-wallpapers-branding.rss'     
];

const pinterestWallpapers: Wallpaper[] = [];

for (const rssUrl of PINTEREST_RSS_URLS) {
  try {
    const response = await fetch(rssUrl, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
      }
    });

    if (response.ok) {
      const xmlText = await response.text();
      const itemRegex = /<item>([\s\S]*?)<\/item>/g;
      let match;

      // URL exacta y directa del tablero correspondiente
      const targetBoardUrl = rssUrl.replace('.rss', '');

      while ((match = itemRegex.exec(xmlText)) !== null) {
        const itemContent = match[1];
        
        const titleMatch = itemContent.match(/<title>([\s\S]*?)<\/title>/);
        const descMatch = itemContent.match(/<description>([\s\S]*?)<\/description>/);
        
        const rawTitle = titleMatch 
          ? titleMatch[1].replace('<![CDATA[', '').replace(']]>', '').trim() 
          : '';

        const descText = descMatch ? descMatch[1] : '';
        const imgMatch =
          descText.match(/src="(https:\/\/i\.pinimg\.com\/[^"]+)"/) ||
          itemContent.match(/(https:\/\/i\.pinimg\.com\/[^"'\s]+?\.(?:jpg|png|webp))/i);

        const imageUrl = imgMatch?.[1] ? imgMatch[1].replace(/\/\d+x\//, '/736x/') : '';

        // Si falta imagen o título real, se salta este ítem y continúa con el siguiente
        if (!imageUrl || !rawTitle) {
          continue;
        }

        let cleanTitle = rawTitle.split('#')[0].split('|')[0].trim();
        if (!cleanTitle) {
          continue;
        }
        if (cleanTitle.length > 45) {
          cleanTitle = `${cleanTitle.substring(0, 42)}...`;
        }

        pinterestWallpapers.push({
          id: `pin-${pinterestWallpapers.length}`,
          title: cleanTitle,
          category: 'Mobile',
          resolution: '1080x1920 (FHD+)',
          aspectRatio: '9:16',
          image: imageUrl,
          pinterestUrl: targetBoardUrl
        });
      }
    } else {
      console.warn(`[Pinterest RSS] Advertencia: La URL ${rssUrl} respondió con estado ${response.status}`);
    }
  } catch (error) {
    console.error(`[Pinterest RSS Error crítico para ${rssUrl}]:`, error);
  }
}

console.log(`[Veyxara System] Pines de Pinterest cargados exitosamente: ${pinterestWallpapers.length}`);

// 3. Selección Aleatoria Estática (Carrusel intacto que elige una imagen al azar por recarga)
const featuredPool = [...wallpapersBrand, ...pcWallpapers];
const randomFeatured = featuredPool.length > 0 
  ? featuredPool[Math.floor(Math.random() * featuredPool.length)] 
  : null;
---

<Layout title="Veyxara Core | Wallpapers y Activos">
  <main class="w-full min-h-screen bg-[#040914] text-[#E8EEF5] py-12 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- SECCIÓN SUPERIOR: TÍTULO + IMAGEN DESTACADA ALEATORIA -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-16">
        
        <div class="lg:col-span-7 text-left">
          <span class="text-xs font-mono text-[#00CFFF] uppercase tracking-widest">Repositorio Oficial</span>
          <h1 class="text-3xl md:text-5xl font-bold font-mono text-[#E8EEF5] mt-2 mb-4">
            Veyxara Core | <span class="text-[#FF9900]">Wallpapers</span>
          </h1>
          <p class="text-sm md:text-base text-zinc-400 leading-relaxed max-w-xl">
            Recursos institucionales exclusivos, fondos de escritorio para PC en alta definición y galería móvil sincronizada automáticamente desde nuestros tableros en <span class="text-[#FF9900] font-semibold">Pinterest</span>.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="relative w-full aspect-[16/9] bg-[#071426] border border-[#00CFFF]/40 rounded-2xl overflow-hidden shadow-[0_0_20px_rgba(0,207,255,0.15)]">
            {randomFeatured ? (
              <div class="w-full h-full relative">
                <img src={randomFeatured.image} alt={randomFeatured.title} class="w-full h-full object-cover object-center" />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#040914] via-[#040914]/70 to-transparent p-4">
                  <span class="text-[10px] font-mono text-[#00CFFF] uppercase">{randomFeatured.category}</span>
                  <h4 class="text-xs md:text-sm font-bold text-[#E8EEF5] truncate">{randomFeatured.title}</h4>
                </div>
              </div>
            ) : (
              <div class="flex items-center justify-center h-full text-xs font-mono text-zinc-500">
                Sin imagen destacada
              </div>
            )}
          </div>
        </div>

      </div>

      <!-- SECCIÓN 1: ACTIVOS CORPORATIVOS & MARCA -->
      {wallpapersBrand.length > 0 && (
        <section class="mb-20">
          <div class="border-b border-zinc-800 pb-4 mb-8 flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold font-mono text-[#00CFFF] flex items-center gap-2">
                <span>🛡️ Activos Corporativos & Marca</span>
              </h2>
              <p class="text-xs text-zinc-400 mt-1">Recursos institucionales oficiales y emblemas de Veyxara Core.</p>
            </div>
            <span class="text-xs font-mono px-3 py-1 bg-[#071426] border border-[#00CFFF]/30 text-[#00CFFF] rounded-full">
              Exclusivos
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {wallpapersBrand.map((wallpaper, index) => (
              <WallpaperCard wallpaper={wallpaper} index={`brand-${index}`} />
            ))}
          </div>
        </section>
      )}

      <!-- SECCIÓN 2: FONDOS DE ESCRITORIO PC -->
      <section class="mb-20">
        <div class="border-b border-zinc-800 pb-4 mb-8 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold font-mono text-[#FF9900] flex items-center gap-2">
              <span>🖥️ Fondos de Escritorio (PC)</span>
            </h2>
            <p class="text-xs text-zinc-400 mt-1">Alta resolución local con descarga directa optimizada por motor web.</p>
          </div>
        </div>

        {pcWallpapers.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {pcWallpapers.map((wallpaper, index) => (
              <WallpaperCard wallpaper={wallpaper} index={`pc-${index}`} />
            ))}
          </div>
        ) : (
          <div class="text-center py-12 font-mono text-zinc-500 bg-[#071426]/30 border border-zinc-800 rounded-xl">
            No hay fondos de PC registrados en <code>wallpapers.ts</code>.
          </div>
        )}
      </section>

      <!-- SECCIÓN 3: GALERÍA MÓVIL (PINTEREST) -->
      <section>
        <div class="border-b border-zinc-800 pb-4 mb-8 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold font-mono text-[#00CFFF] flex items-center gap-2">
              <span>📱 Galería Móvil (Pinterest)</span>
            </h2>
            <p class="text-xs text-zinc-400 mt-1">Sincronización automática en vivo desde nuestros tableros de Pinterest.</p>
          </div>
          <span class="text-xs font-mono px-3 py-1 bg-[#071426] border border-[#FF9900]/30 text-[#FF9900] rounded-full">
            Cloud CDN
          </span>
        </div>

        {pinterestWallpapers.length > 0 ? (
          <>
            <div id="pinterest-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {pinterestWallpapers.map((wallpaper, index) => (
                <div class={`pinterest-block-item ${index >= 12 ? 'hidden' : ''}`}>
                  <WallpaperCard wallpaper={wallpaper} index={`pin-${index}`} />
                </div>
              ))}
            </div>

            {pinterestWallpapers.length > 12 && (
              <div class="mt-10 flex justify-center">
                <button
                  id="load-more-pinterest-btn"
                  type="button"
                  class="px-6 py-2.5 rounded-xl bg-[#071426] border border-[#00CFFF]/50 text-[#00CFFF] font-mono text-sm font-bold hover:bg-[#00CFFF] hover:text-[#040914] transition-all cursor-pointer"
                >
                  Cargar más
                </button>
              </div>
            )}
          </>
        ) : (
          <div class="text-center py-16 font-mono text-zinc-500 bg-[#071426]/30 border border-zinc-800 rounded-xl">
            Sincronizando galería externa de Pinterest... (Verificando conexión con los tableros RSS).
          </div>
        )}
      </section>

    </div>
  </main>
</Layout>

<script>
  const setupPinterestLoadMore = () => {
    const btn = document.getElementById('load-more-pinterest-btn');
    if (!btn || btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';

    const STEP = 12;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.pinterest-block-item'));

    const syncButton = () => {
      const hiddenLeft = items.some((el) => el.classList.contains('hidden'));
      if (!hiddenLeft) {
        btn.classList.add('hidden');
      }
    };

    btn.addEventListener('click', () => {
      let shown = 0;
      for (const el of items) {
        if (el.classList.contains('hidden')) {
          el.classList.remove('hidden');
          shown += 1;
          if (shown >= STEP) break;
        }
      }
      syncButton();
    });

    syncButton();
  };

  document.addEventListener('DOMContentLoaded', setupPinterestLoadMore);
  document.addEventListener('astro:page-load', setupPinterestLoadMore);
</script>